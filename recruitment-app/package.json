{
  "name": "rivet-recruitment",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run db:build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:build": "prisma db push && tsx prisma/seed.ts",
    "seed": "prisma db push && tsx prisma/seed.ts",
    "reseed": "npm run seed",
    "fit:local": "tsx scripts/fit-local.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:ui": "node scripts/ui-check.mjs",
    "audit:ai": "tsx scripts/ai-audit.ts",
    "audit:live": "tsx scripts/ai-live-reading.ts",
    "eval:reading": "tsx scripts/ai-reading-eval.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "monaco-editor": "0.57.0",
    "motion": "^14.14.0",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "playwright-core": "1.65.1",
    "postcss": "^8.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
