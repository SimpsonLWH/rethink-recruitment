generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Event {
  id        String   @id
  slug      String   @unique
  name      String
  city      String
  dateLabel String
  tagline   String
  createdAt DateTime @default(now())

  candidates         Candidate[]
  employers          Employer[]
  roles              Role[]
  decisions          Decision[]
  matches            Match[]
  drafts             TailoringDraft[]
  fitSummaries       FitSummary[]
  assessments        Assessment[]
  assessmentAttempts AssessmentAttempt[]
  invitations        Invitation[]
  outcomes           Outcome[]
  reviewRequests     ReviewRequest[]
  accounts           Account[]
}

/// Demo-only account record. Passwords are stored as scrypt hashes, but this is
/// not production authentication: there is no email verification, reset or rate limit.
model Account {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  side         String
  email        String   @unique
  passwordHash String
  passwordSalt String
  personId     String
  createdAt    DateTime @default(now())

  @@index([side])
  @@index([personId])
}

model Candidate {
  id                     String    @id
  slug                   String    @unique
  eventId                String
  event                  Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                   String
  headline               String
  location               String
  bio                    String
  monogram               String
  palette                String
  tagsJson               String    @default("[]")
  interestsJson          String    @default("[]")
  availability           String    @default("")
  discoveryOptIn         Boolean   @default(false)
  cvFileName             String?
  cvSource               String?
  cvUploadedAt           DateTime?
  order                  Int
  priorityIntroAllowance Int       @default(1)
  likeAllowance          Int       @default(5)
  synthetic              Boolean   @default(true)
  createdAt              DateTime  @default(now())

  facts              Fact[]
  decisions          Decision[]
  matches            Match[]
  drafts             TailoringDraft[]
  fitSummaries       FitSummary[]
  assessmentAttempts AssessmentAttempt[]
  invitations        Invitation[]
  outcomes           Outcome[]
  reviewRequests     ReviewRequest[]

  @@index([eventId])
}

model Employer {
  id                     String   @id
  slug                   String   @unique
  eventId                String
  event                  Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                   String
  tagline                String
  about                  String
  industry               String
  teamSize               String
  location               String
  logoMark               String
  palette                String
  contactName            String   @default("Hiring team")
  order                  Int
  priorityIntroAllowance Int      @default(1)
  likeAllowance          Int      @default(10)
  synthetic              Boolean  @default(true)
  createdAt              DateTime @default(now())

  prompts        EmployerPrompt[]
  roles          Role[]
  confirmedFacts Fact[]           @relation("EmployerConfirmations")

  @@index([eventId])
}

model Role {
  id                  String      @id
  slug                String      @unique
  eventId             String
  event               Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employerId          String
  employer            Employer    @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title               String
  employmentType      String
  workMode            String
  location            String
  summary             String
  whyJoin             String
  problemNow          String
  first90             String
  skillsJson          String      @default("[]")
  portfolioRequired   Boolean     @default(false)
  roleFamily          String      @default("Software engineering")
  assessmentId        String?
  assessment          Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  requiredScore       Int?
  requirementsJson    String      @default("[]")
  evidenceSignalsJson String      @default("[]")
  configStatus        String      @default("DRAFT")
  reviewOwnerName     String?
  reviewDueHours      Int         @default(48)
  publishedAt         DateTime?
  order               Int
  createdAt           DateTime    @default(now())

  decisions      Decision[]
  matches        Match[]
  drafts         TailoringDraft[]
  fitSummaries   FitSummary[]
  invitations    Invitation[]
  outcomes       Outcome[]
  reviewRequests ReviewRequest[]

  @@index([eventId, employerId])
  @@index([assessmentId])
}

model EmployerPrompt {
  id         String   @id @default(cuid())
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  prompt     String
  answer     String
  order      Int

  @@index([employerId, order])
}

model Fact {
  id                    String    @id @default(cuid())
  candidateId           String
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  prompt                String
  claim                 String
  skillTagsJson         String    @default("[]")
  metaJson              String    @default("{}")
  evidenceUrl           String?
  provenance            String    @default("SELF_CLAIMED")
  confirmedByEmployerId String?
  confirmedByEmployer   Employer? @relation("EmployerConfirmations", fields: [confirmedByEmployerId], references: [id], onDelete: SetNull)
  origin                String    @default("SEED")
  order                 Int
  createdAt             DateTime  @default(now())

  linkCheck LinkCheck?

  @@index([candidateId, order])
}

model Assessment {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug         String   @unique
  title        String
  roleFamily   String
  family       String
  version      String
  difficulty   String
  description  String
  problemsJson String   @default("[]")
  playable     Boolean  @default(false)
  order        Int
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  roles    Role[]
  attempts AssessmentAttempt[]

  @@index([eventId, family, difficulty])
}

model AssessmentAttempt {
  id              String     @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  problemIdsJson  String
  submissionsJson String?
  resultsJson     String?
  score           Int?
  startedAt       DateTime   @default(now())
  submittedAt     DateTime?

  invitations Invitation[]
  event       Event?       @relation(fields: [eventId], references: [id])
  eventId     String?

  @@unique([assessmentId, candidateId])
  @@index([candidateId, submittedAt])
  @@index([assessmentId])
}

model Decision {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actorType   String
  action      String
  source      String    @default("SWIPE")
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([roleId, candidateId, actorType])
  @@index([eventId, actorType])
  @@index([candidateId])
}

model Match {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage          String    @default("INTRO_CALL")
  stageUpdatedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  lastMessageAt  DateTime?

  messages Message[]

  @@unique([roleId, candidateId])
  @@index([eventId])
  @@index([candidateId])
}

model Invitation {
  id             String             @id @default(cuid())
  eventId        String
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  message        String
  citedAttemptId String?
  citedAttempt   AssessmentAttempt? @relation(fields: [citedAttemptId], references: [id], onDelete: SetNull)
  status         String             @default("PENDING")
  createdAt      DateTime           @default(now())
  respondedAt    DateTime?

  @@unique([roleId, candidateId])
  @@index([eventId, status])
  @@index([candidateId, status])
}

model Outcome {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String
  message     String
  deliveredAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@unique([roleId, candidateId])
  @@index([candidateId, deliveredAt])
}

model ReviewRequest {
  id                  String    @id @default(cuid())
  eventId             String
  event               Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId              String
  role                Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  note                String?
  evidenceFactIdsJson String    @default("[]")
  status              String    @default("PENDING")
  dueAt               DateTime
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?
  resolution          String?

  @@unique([roleId, candidateId])
  @@index([eventId, status])
  @@index([candidateId])
}

model Message {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderType String
  body       String
  createdAt  DateTime @default(now())

  @@index([matchId, createdAt])
}

model TailoringDraft {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status      String    @default("DRAFT")
  engine      String    @default("fallback")
  model       String?
  note        String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items TailoringItem[]

  @@unique([candidateId, roleId])
  @@index([eventId])
}

model TailoringItem {
  id                String         @id @default(cuid())
  draftId           String
  draft             TailoringDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  kind              String
  sourceFactIdsJson String
  suggestedText     String
  editedText        String?
  rationale         String
  status            String         @default("SUGGESTED")
  order             Int
  createdAt         DateTime       @default(now())

  @@index([draftId, order])
}

model LinkCheck {
  factId     String   @id
  fact       Fact     @relation(fields: [factId], references: [id], onDelete: Cascade)
  status     String
  httpStatus Int?
  detail     String?
  checkedAt  DateTime @default(now())
}

model AiRun {
  id        String   @id @default(cuid())
  kind      String
  provider  String
  model     String
  mode      String
  status    String
  latencyMs Int?
  error     String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model AiCache {
  key          String   @id
  kind         String
  responseJson String
  createdAt    DateTime @default(now())
}

model FitSummary {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  digest           String
  sharedThemesJson String
  questionsJson    String
  evidenceCoverage Int
  generatedBy      String
  createdAt        DateTime  @default(now())

  @@unique([roleId, candidateId])
  @@index([eventId])
}
