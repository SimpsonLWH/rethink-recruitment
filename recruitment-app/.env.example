# Rivet works with NO environment variables.
# Everything below is optional and only enables live integrations.
# Copy to .env.local and add only the keys you are authorised to use.

# NVIDIA Build — Nemotron 3.5 Super VL (highlight extraction + tailoring)
NVIDIA_API_KEY=

# Google AI Studio — Gemini (employer "ask this profile" Q&A)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Modal — optional Python fit-brief batch job (never required by the app)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
